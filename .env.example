# SHADOWNET Configuration
# Copy this file to .env and fill in your values

# LLM Provider Configuration
# Options: 'openai' or 'gemini'
LLM_PROVIDER=openai

# LLM API Key
# Get your API key from:
# - OpenAI: https://platform.openai.com/api-keys
# - Gemini: https://makersuite.google.com/app/apikey
LLM_API_KEY=your-api-key-here

# Optional: LLM Model
# OpenAI: gpt-4, gpt-3.5-turbo, etc.
# Gemini: gemini-pro, gemini-1.5-pro, etc.
# LLM_MODEL=gpt-3.5-turbo

# Server Configuration
# Port for the Express server
PORT=3000

# Simulation Configuration
# Number of agents (must be between 12 and 20)
AGENT_COUNT=15

# Initial balance for each agent (in credits)
INITIAL_BALANCE=1000

# Minimum delay between decision cycles (in milliseconds)
MIN_CYCLE_DELAY=5000

# Maximum delay between decision cycles (in milliseconds)
MAX_CYCLE_DELAY=10000

# Block finalization interval (in milliseconds)
BLOCK_INTERVAL=30000

# Logging Configuration
# Log level: error, warn, info, debug
LOG_LEVEL=info
